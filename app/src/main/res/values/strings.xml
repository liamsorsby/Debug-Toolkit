    <string name="consent_gate_title">Before you start</string>
    <string name="consent_gate_body">Debug Toolkit uses privacy-safe analytics to understand which tools are useful and where diagnostics fail, so it can be improved over time. Entered endpoints and diagnostic results are never collected. Crash and performance monitoring always run, separately from this choice, to keep the app stable.</string>
    <string name="consent_gate_body_secondary">You can change this at any time from Settings.</string>
    <string name="consent_gate_accept">Accept</string>
    <string name="consent_gate_decline">Decline</string>

    <string name="about_privacy">Privacy</string>
    <string name="about_privacy_body">Debug Toolkit stores only theme and consent preferences. Crash and performance monitoring are collected at all times to diagnose failures and keep the app reliable. Analytics require explicit consent and never include entered endpoints or diagnostic results. DNS and speed tests contact Cloudflare; certificate and HTTP tools contact the endpoint you enter.</string>
    <string name="about_measurements">Measurements</string>
    <string name="about_measurements_body">Wi-Fi dBm indicates signal strength, not physical distance. Speed results are point-in-time estimates affected by device and network conditions.</string>
