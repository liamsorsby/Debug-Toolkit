{
  "name": "debug-toolkit-release",
  "version": "0.0.0-development",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "commitlint": "commitlint",
    "release": "semantic-release",
    "release:preview": "node .github/scripts/version-preview.mjs",
    "site:strings": "node privacy-policy/site/scripts/generate-strings.mjs",
    "test:site": "node privacy-policy/site/scripts/generate-strings.mjs --check && node --test \"privacy-policy/site/test/*.test.js\""
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@semantic-release/commit-analyzer": "13.0.1",
    "@semantic-release/exec": "7.1.0",
    "@semantic-release/github": "12.0.10",
    "@semantic-release/release-notes-generator": "14.1.1",
    "conventional-changelog-conventionalcommits": "9.3.1",
    "semantic-release": "25.0.9",
    "semver": "7.8.5"
  }
}
